# Collected data is never committed: several sources forbid redistribution.
# Everything the pipeline produces is under data/ (parquet, csv, json, reports, plus the
# raw and interim working folders).
# Only DVC pointer files (*.dvc) under data/ are committed; the data itself is in DVC.
data/**
!data/**/
!data/**/*.dvc
logs/
# Folder names of earlier layouts, still ignored in case an output is pointed back here.
exports/
annotation/
reports/

# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Web app: accounts database and JavaScript dependencies
*.db
*.db-journal
node_modules/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tujya: extra virtual environments (dev pipeline venv, vision venv) and ML outputs
.venv-*/
vision/.venv/
vision/runs/
mlruns/
mlartifacts/
*.onnx
*.pt
